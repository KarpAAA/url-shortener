# Copy to .env for local development (pnpm dev). docker compose needs no .env.
NODE_ENV=development
PORT=3000

# Public origin of this service: used to build shortUrl and to reject links to itself.
PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://shortener:shortener@localhost:5432/shortener
# Connections per instance; keep the sum over instances below Postgres max_connections
DATABASE_POOL_SIZE=10

LOG_LEVEL=info
LOG_PRETTY=true

# POST /shorten rate limit, per client IP
SHORTEN_RATE_LIMIT=30
SHORTEN_RATE_TTL_SECONDS=60

# Number of reverse proxies in front of the service (0 = none)
TRUST_PROXY_HOPS=0

# Graceful shutdown drain timeout
SHUTDOWN_TIMEOUT_MS=10000
