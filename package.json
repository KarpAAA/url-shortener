{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "Small production-style URL shortener REST API (NestJS, Prisma, PostgreSQL)",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "start": "node dist/entrypoints/main.api.js",
    "dev": "nest start --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --project arch",
    "test:unit": "vitest run --project unit",
    "test:arch": "vitest run --project arch",
    "test:e2e": "vitest run --project e2e",
    "test:int": "vitest run --project e2e int-spec",
    "test:api": "vitest run --project e2e e2e-spec",
    "test:mutation": "stryker run",
    "test:contract": "docker compose -f docker-compose.yml -f docker-compose.schemathesis.yml run --rm --build schemathesis",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "openapi:generate": "node scripts/generate-openapi.mjs docs/openapi.json",
    "openapi:check": "node scripts/generate-openapi.mjs --check docs/openapi.json",
    "trace:update": "node scripts/requirements-trace.mjs",
    "trace:check": "node scripts/requirements-trace.mjs --check"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "nestjs-cls": "7.0.1",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@swc/core": "1.15.18",
    "@testcontainers/postgresql": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "5.4.0",
    "eslint-plugin-import": "2.32.0",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "testcontainers": "12.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  },
  "lint-staged": {
    "*.{ts,mts,mjs,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
